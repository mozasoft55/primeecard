{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "primeecard",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "node build.js"
  },
  "observability": {
    "enabled": true
  }
}
